---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Locations" description="Framework Systems serves businesses throughout the Shoals region including Tuscumbia, Florence, Muscle Shoals, and Sheffield, Alabama.">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-secondary-900 to-secondary-800 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Service Areas</h1>
      <p class="text-xl text-secondary-300 max-w-3xl mx-auto">
        Proudly serving businesses throughout the Shoals region of Northwest Alabama.
      </p>
    </div>
  </section>

  <!-- Primary Location -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Headquarters
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">
            Tuscumbia, Alabama
          </h2>
          <p class="text-lg text-secondary-600 mb-6">
            Framework Systems is headquartered in historic Tuscumbia, the birthplace of Helen Keller and the heart of the Shoals region. Our central location allows us to serve businesses throughout Northwest Alabama efficiently.
          </p>
          <div class="space-y-4 text-secondary-600">
            <div class="flex items-start">
              <svg class="w-6 h-6 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <p class="font-semibold text-secondary-900">Colbert County</p>
                <p>Serving the Tuscumbia area and surrounding communities</p>
              </div>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <p class="font-semibold text-secondary-900">Rapid Response</p>
                <p>On-site support available throughout the Shoals</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-secondary-100 rounded-2xl p-8">
          <div class="aspect-video bg-secondary-200 rounded-lg flex items-center justify-center">
            <svg class="w-24 h-24 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
          </div>
          <p class="text-center text-secondary-500 mt-4">The Shoals Region, Northwest Alabama</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas Grid -->
  <section class="py-20 bg-secondary-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">The Shoals Region</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          We provide comprehensive IT services to businesses across all four cities of the Shoals.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Tuscumbia -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Tuscumbia</h3>
          <p class="text-secondary-600 mb-4">Home base serving downtown businesses, industrial areas, and surrounding neighborhoods.</p>
          <p class="text-sm text-primary-600 font-semibold">Colbert County</p>
        </div>

        <!-- Florence -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Florence</h3>
          <p class="text-secondary-600 mb-4">Supporting businesses in the largest city of the Shoals, including the UNA area.</p>
          <p class="text-sm text-primary-600 font-semibold">Lauderdale County</p>
        </div>

        <!-- Muscle Shoals -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Muscle Shoals</h3>
          <p class="text-secondary-600 mb-4">Serving the famous music city and its growing business community.</p>
          <p class="text-sm text-primary-600 font-semibold">Colbert County</p>
        </div>

        <!-- Sheffield -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Sheffield</h3>
          <p class="text-secondary-600 mb-4">Supporting businesses along the Tennessee River and historic downtown.</p>
          <p class="text-sm text-primary-600 font-semibold">Colbert County</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Extended Service Area -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">Extended Service Area</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Beyond the Shoals, we serve businesses throughout Northwest Alabama and beyond.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="border border-secondary-200 rounded-xl p-6">
          <h3 class="text-lg font-bold mb-3">Colbert County</h3>
          <ul class="space-y-2 text-secondary-600">
            <li>Tuscumbia</li>
            <li>Muscle Shoals</li>
            <li>Sheffield</li>
            <li>Leighton</li>
            <li>Cherokee</li>
          </ul>
        </div>

        <div class="border border-secondary-200 rounded-xl p-6">
          <h3 class="text-lg font-bold mb-3">Lauderdale County</h3>
          <ul class="space-y-2 text-secondary-600">
            <li>Florence</li>
            <li>Rogersville</li>
            <li>Killen</li>
            <li>Anderson</li>
            <li>St. Florian</li>
          </ul>
        </div>

        <div class="border border-secondary-200 rounded-xl p-6">
          <h3 class="text-lg font-bold mb-3">Surrounding Areas</h3>
          <ul class="space-y-2 text-secondary-600">
            <li>Franklin County</li>
            <li>Lawrence County</li>
            <li>Marion County</li>
            <li>Winston County</li>
            <li>Remote services available statewide</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Local Matters -->
  <section class="py-20 bg-secondary-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-6">
            Why Local Matters
          </h2>
          <p class="text-lg text-secondary-600 mb-6">
            When you partner with Framework Systems, you're working with a neighbor who understands the unique needs and opportunities of doing business in the Shoals region.
          </p>
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="flex-shrink-0 w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold">Fast Response Times</h3>
                <p class="text-secondary-600">On-site support typically within hours, not days.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold">Community Investment</h3>
                <p class="text-secondary-600">We're invested in the success of Shoals businesses.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0 w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold">Local Knowledge</h3>
                <p class="text-secondary-600">Understanding of regional infrastructure and business needs.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-xl">
          <h3 class="text-2xl font-bold mb-6">Serving Your Area?</h3>
          <p class="text-secondary-600 mb-6">
            Contact us to confirm service availability in your location and discuss how we can help your business.
          </p>
          <a href="/contact" class="block w-full bg-primary-600 hover:bg-primary-700 text-white text-center py-3 rounded-lg font-semibold transition-colors">
            Contact Us Today
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
