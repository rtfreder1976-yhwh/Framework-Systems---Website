---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Locations" description="Framework Systems serves local businesses throughout the Shoals region - Tuscumbia, Florence, Muscle Shoals, and Sheffield, Alabama. AI-powered business automation.">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-secondary-900 to-secondary-800 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Serving the Shoals</h1>
      <p class="text-xl text-secondary-300 max-w-3xl mx-auto">
        AI-powered automations for local businesses throughout Northwest Alabama.
      </p>
    </div>
  </section>

  <!-- Primary Location -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Headquarters
          </div>
          <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">
            Tuscumbia, Alabama
          </h2>
          <p class="text-lg text-secondary-600 mb-6">
            Based in the heart of the Shoals, we serve local businesses who are tired of losing money to missed calls, slow follow-ups, and manual tasks that eat their day.
          </p>
          <p class="text-lg text-secondary-600 mb-6">
            Why local matters: When we build your automation live, we can sit across from you. When you need support, we're a quick drive away. We're invested in Shoals businesses because we live here too.
          </p>

          <div class="bg-secondary-50 rounded-xl p-6">
            <h3 class="font-bold text-secondary-900 mb-4">Industries We Serve Locally:</h3>
            <div class="grid grid-cols-2 gap-2 text-secondary-600">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                HVAC Companies
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Plumbers
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Dental Offices
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Salons & Spas
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Contractors
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Restaurants
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Law Firms
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Medical Clinics
              </div>
            </div>
          </div>
        </div>
        <div class="bg-secondary-900 rounded-2xl p-8 text-white">
          <div class="text-center mb-8">
            <div class="text-6xl font-bold text-primary-400 mb-2">4</div>
            <div class="text-xl">Cities Served</div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-secondary-800 rounded-lg p-4 text-center">
              <div class="font-bold">Tuscumbia</div>
              <div class="text-sm text-secondary-400">HQ</div>
            </div>
            <div class="bg-secondary-800 rounded-lg p-4 text-center">
              <div class="font-bold">Florence</div>
              <div class="text-sm text-secondary-400">Full Service</div>
            </div>
            <div class="bg-secondary-800 rounded-lg p-4 text-center">
              <div class="font-bold">Muscle Shoals</div>
              <div class="text-sm text-secondary-400">Full Service</div>
            </div>
            <div class="bg-secondary-800 rounded-lg p-4 text-center">
              <div class="font-bold">Sheffield</div>
              <div class="text-sm text-secondary-400">Full Service</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas Grid -->
  <section class="py-20 bg-secondary-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">The Shoals Region</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          We build AI automations for businesses across all four cities of the Shoals.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Tuscumbia -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold mb-2">Tuscumbia</h3>
          <p class="text-primary-600 font-semibold text-sm mb-4">Headquarters</p>
          <p class="text-secondary-600 mb-4">Home base. Live demos available same-day. Serving downtown businesses and surrounding areas.</p>
          <div class="text-sm text-secondary-500">Colbert County</div>
        </div>

        <!-- Florence -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold mb-2">Florence</h3>
          <p class="text-primary-600 font-semibold text-sm mb-4">Full Service</p>
          <p class="text-secondary-600 mb-4">The largest city in the Shoals. Serving businesses from downtown to the UNA area.</p>
          <div class="text-sm text-secondary-500">Lauderdale County</div>
        </div>

        <!-- Muscle Shoals -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold mb-2">Muscle Shoals</h3>
          <p class="text-primary-600 font-semibold text-sm mb-4">Full Service</p>
          <p class="text-secondary-600 mb-4">The famous music city. Growing business community ready for automation.</p>
          <div class="text-sm text-secondary-500">Colbert County</div>
        </div>

        <!-- Sheffield -->
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-bold mb-2">Sheffield</h3>
          <p class="text-primary-600 font-semibold text-sm mb-4">Full Service</p>
          <p class="text-secondary-600 mb-4">Historic downtown and Tennessee River corridor businesses.</p>
          <div class="text-sm text-secondary-500">Colbert County</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Extended Service Area -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">Extended Coverage</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          We also serve businesses throughout Northwest Alabama. Remote demos available.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="border border-secondary-200 rounded-xl p-6">
          <h3 class="text-lg font-bold mb-3">Colbert County</h3>
          <ul class="space-y-2 text-secondary-600">
            <li>Tuscumbia</li>
            <li>Muscle Shoals</li>
            <li>Sheffield</li>
            <li>Leighton</li>
            <li>Cherokee</li>
          </ul>
        </div>

        <div class="border border-secondary-200 rounded-xl p-6">
          <h3 class="text-lg font-bold mb-3">Lauderdale County</h3>
          <ul class="space-y-2 text-secondary-600">
            <li>Florence</li>
            <li>Rogersville</li>
            <li>Killen</li>
            <li>Anderson</li>
            <li>St. Florian</li>
          </ul>
        </div>

        <div class="border border-secondary-200 rounded-xl p-6">
          <h3 class="text-lg font-bold mb-3">Surrounding Areas</h3>
          <ul class="space-y-2 text-secondary-600">
            <li>Franklin County</li>
            <li>Lawrence County</li>
            <li>Marion County</li>
            <li>Winston County</li>
            <li class="text-primary-600 font-semibold">Remote available anywhere</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Local -->
  <section class="py-20 bg-secondary-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold mb-6">
            Why Local Beats National
          </h2>
          <p class="text-lg text-secondary-300 mb-6">
            Big automation agencies are based in cities you've never visited. They send proposals. They schedule calls for 3 weeks out. They charge $15,000 and take months to deliver.
          </p>
          <p class="text-lg text-secondary-300">
            We sit across from you at a coffee shop in Florence. We build your automation while you watch. It's running before you finish your coffee. That's the difference.
          </p>
        </div>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-1">Same-Day Demos</h3>
              <p class="text-secondary-400">We can meet in person and build your automation live, today.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-1">Face-to-Face Support</h3>
              <p class="text-secondary-400">When you need help, we're a short drive away, not a timezone away.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-1">Invested in the Shoals</h3>
              <p class="text-secondary-400">We live here. Your success is our community's success.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Ready for a Live Demo?</h2>
      <p class="text-xl text-primary-100 mb-8">
        We can meet anywhere in the Shoals. Or jump on a video call if you prefer.
      </p>
      <a href="/contact" class="inline-flex items-center bg-white text-primary-600 hover:bg-primary-50 px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
        Schedule Demo
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
