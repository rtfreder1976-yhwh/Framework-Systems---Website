---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Framework Systems builds AI-powered automations for local businesses in Tuscumbia, Alabama. Missed call text-back, review automation, AI receptionists, and more. Built in minutes, runs 24/7.">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-secondary-900 via-secondary-800 to-primary-900 text-white py-20 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-500/20 border border-primary-500/30 rounded-full text-primary-300 text-sm font-medium mb-6">
            AI-Powered Business Automation
          </div>
          <h1 class="text-4xl lg:text-6xl font-bold mb-6">
            Stop Losing Customers to <span class="text-primary-400">Missed Calls</span> and <span class="text-primary-400">Slow Follow-Ups</span>
          </h1>
          <p class="text-xl text-secondary-300 mb-8">
            We build AI automations that answer calls, send texts, recover no-shows, and generate reviews while you sleep. Built in minutes. Runs 24/7. No tech skills needed.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-semibold text-center transition-colors text-lg">
              See It Built Live
            </a>
            <a href="/services" class="border border-white/30 hover:bg-white/10 px-8 py-4 rounded-lg font-semibold text-center transition-colors text-lg">
              View Automations
            </a>
          </div>
          <div class="mt-8 flex items-center gap-8 text-secondary-400">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>5-min build time</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>70% close rate</span>
            </div>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="bg-secondary-800/50 backdrop-blur border border-secondary-700 rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="text-secondary-500 text-sm ml-2">workflow.ai</span>
            </div>
            <div class="space-y-3 font-mono text-sm">
              <div class="text-secondary-500">// Missed call detected</div>
              <div class="text-primary-400">trigger: "missed_call"</div>
              <div class="text-secondary-500">// Wait 30 seconds</div>
              <div class="text-green-400">delay: 30s</div>
              <div class="text-secondary-500">// Send personalized SMS</div>
              <div class="text-yellow-400">sms: "Hey {'{'}name{'}'}, sorry we missed you!"</div>
              <div class="text-secondary-500">// Route reply to owner</div>
              <div class="text-primary-400">route: owner.phone</div>
              <div class="mt-4 flex items-center gap-2 text-green-400">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span>Deployed & running in 3 minutes</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">You're Losing Money Every Day</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          These problems cost local businesses thousands every month. Sound familiar?
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-8 bg-red-50 border border-red-100 rounded-xl">
          <div class="text-4xl font-bold text-red-600 mb-2">68%</div>
          <h3 class="text-xl font-bold mb-2 text-secondary-900">Missed calls never call back</h3>
          <p class="text-secondary-600">Every unanswered call is a customer going to your competitor.</p>
        </div>

        <div class="p-8 bg-red-50 border border-red-100 rounded-xl">
          <div class="text-4xl font-bold text-red-600 mb-2">$67K</div>
          <h3 class="text-xl font-bold mb-2 text-secondary-900">Lost to no-shows annually</h3>
          <p class="text-secondary-600">Empty appointment slots that could have been filled.</p>
        </div>

        <div class="p-8 bg-red-50 border border-red-100 rounded-xl">
          <div class="text-4xl font-bold text-red-600 mb-2">10x</div>
          <h3 class="text-xl font-bold mb-2 text-secondary-900">More happy customers than reviews</h3>
          <p class="text-secondary-600">You never ask, so they never leave one.</p>
        </div>

        <div class="p-8 bg-red-50 border border-red-100 rounded-xl">
          <div class="text-4xl font-bold text-red-600 mb-2">2 days</div>
          <h3 class="text-xl font-bold mb-2 text-secondary-900">To send a quote</h3>
          <p class="text-secondary-600">Your competitor sends theirs in 2 hours.</p>
        </div>

        <div class="p-8 bg-red-50 border border-red-100 rounded-xl">
          <div class="text-4xl font-bold text-red-600 mb-2">$35K+</div>
          <h3 class="text-xl font-bold mb-2 text-secondary-900">Receptionist salary</h3>
          <p class="text-secondary-600">And they still can't answer calls at 2am.</p>
        </div>

        <div class="p-8 bg-red-50 border border-red-100 rounded-xl">
          <div class="text-4xl font-bold text-red-600 mb-2">60%</div>
          <h3 class="text-xl font-bold mb-2 text-secondary-900">Late payments</h3>
          <p class="text-secondary-600">Nobody wants to send the awkward follow-up email.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-20 bg-secondary-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">AI Automations That Fix It All</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          We build these in front of you. Watch your problem get solved in under 10 minutes.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow border border-secondary-100">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div class="text-sm text-primary-600 font-semibold mb-2">$800 - $1,500</div>
          <h3 class="text-xl font-bold mb-3">Missed Call Text-Back</h3>
          <p class="text-secondary-600 mb-4">Instantly text anyone who calls when you can't answer. Routes replies to you or books appointments automatically.</p>
          <div class="text-sm text-secondary-500">Best for: HVAC, Plumbers, Contractors, Salons</div>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow border border-secondary-100">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
          </div>
          <div class="text-sm text-primary-600 font-semibold mb-2">$500 - $1,200</div>
          <h3 class="text-xl font-bold mb-3">Review Request Automation</h3>
          <p class="text-secondary-600 mb-4">24 hours after service, automatically request a Google review via SMS. Follow up once if no action.</p>
          <div class="text-sm text-secondary-500">Best for: Restaurants, Clinics, Auto Shops</div>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow border border-secondary-100">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="text-sm text-primary-600 font-semibold mb-2">$1,200 - $2,500</div>
          <h3 class="text-xl font-bold mb-3">No-Show Recovery</h3>
          <p class="text-secondary-600 mb-4">Detect no-shows, send empathetic rebooking message with available slots. Recovers 30-40% of lost appointments.</p>
          <div class="text-sm text-secondary-500">Best for: Med Spas, Salons, Therapists, PT Clinics</div>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow border border-secondary-100">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="text-sm text-primary-600 font-semibold mb-2">$2,000 - $4,000</div>
          <h3 class="text-xl font-bold mb-3">AI Receptionist</h3>
          <p class="text-secondary-600 mb-4">AI answers calls 24/7, handles FAQs, books appointments, routes urgent calls to your cell. Logs everything.</p>
          <div class="text-sm text-secondary-500">Best for: Law Firms, Medical Offices, Trades</div>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow border border-secondary-100">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div class="text-sm text-primary-600 font-semibold mb-2">$1,500 - $3,000</div>
          <h3 class="text-xl font-bold mb-3">Instant Quote Generator</h3>
          <p class="text-secondary-600 mb-4">Client fills short form, AI generates accurate quote, sends branded PDF instantly. Follow-up if no response.</p>
          <div class="text-sm text-secondary-500">Best for: Cleaners, Landscapers, Movers</div>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-shadow border border-secondary-100">
          <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="text-sm text-primary-600 font-semibold mb-2">$1,000 - $2,000</div>
          <h3 class="text-xl font-bold mb-3">Invoice Follow-Up</h3>
          <p class="text-secondary-600 mb-4">Auto-remind at 3, 7, 14 days overdue. Reduces late payments by 60%. Alerts you when personal outreach needed.</p>
          <div class="text-sm text-secondary-500">Best for: Any service business</div>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/services" class="inline-flex items-center text-primary-600 hover:text-primary-700 font-semibold text-lg">
          See All 10+ Automations
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-secondary-900 mb-4">How We Work</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          No proposals. No decks. No "let me get back to you." We build it live.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-2xl font-bold text-white">1</span>
          </div>
          <h3 class="text-xl font-bold mb-3">One Question</h3>
          <p class="text-secondary-600">"What's the most annoying part of your day?" You tell us your biggest headache.</p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-2xl font-bold text-white">2</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Live Build</h3>
          <p class="text-secondary-600">We open our laptop and build the solution in front of you. Average time: 5-10 minutes.</p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-2xl font-bold text-white">3</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Test It</h3>
          <p class="text-secondary-600">We trigger it with real data. You see your phone buzz. Your customer gets the text. It works.</p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-2xl font-bold text-white">4</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Turn It On</h3>
          <p class="text-secondary-600">"Want me to leave it running?" That's the close. It runs 24/7 from that moment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Stats -->
  <section class="py-20 bg-secondary-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-400 mb-2">5.4 min</div>
          <p class="text-secondary-400">Average build time</p>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-400 mb-2">$1,750</div>
          <p class="text-secondary-400">Average revenue per workflow</p>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-400 mb-2">70%</div>
          <p class="text-secondary-400">Live demo close rate</p>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-400 mb-2">24/7</div>
          <p class="text-secondary-400">Always running</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-primary-600 to-primary-700 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Ready to See It Built?</h2>
      <p class="text-xl text-primary-100 mb-8">
        Tell us your biggest daily headache. We'll fix it in front of you before you finish your coffee.
      </p>
      <a href="/contact" class="inline-flex items-center bg-white text-primary-600 hover:bg-primary-50 px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
        Schedule Live Demo
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <p class="mt-6 text-primary-200 text-sm">Serving Tuscumbia, Florence, Muscle Shoals, Sheffield & the Shoals region</p>
    </div>
  </section>
</Layout>
