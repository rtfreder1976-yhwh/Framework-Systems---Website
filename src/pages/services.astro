---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services" description="Professional IT and systems architecture services including network design, cloud solutions, security, and consulting in Tuscumbia, Alabama.">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-secondary-900 to-secondary-800 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Our Services</h1>
      <p class="text-xl text-secondary-300 max-w-3xl mx-auto">
        Comprehensive systems architecture solutions designed to help your business thrive in the digital age.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Network Architecture -->
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Core Service
          </div>
          <h2 class="text-3xl font-bold text-secondary-900 mb-4">Network Architecture</h2>
          <p class="text-lg text-secondary-600 mb-6">
            We design and implement robust network infrastructures that form the backbone of your business operations. From small office setups to enterprise-grade solutions, our network architecture services ensure reliable, secure, and scalable connectivity.
          </p>
          <ul class="space-y-3 text-secondary-600">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              LAN/WAN design and implementation
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Network infrastructure assessment
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Wireless network solutions
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Network performance optimization
            </li>
          </ul>
        </div>
        <div class="bg-secondary-100 rounded-2xl p-8 flex items-center justify-center">
          <svg class="w-64 h-64 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
          </svg>
        </div>
      </div>

      <!-- Cloud Solutions -->
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">
        <div class="order-2 lg:order-1 bg-secondary-100 rounded-2xl p-8 flex items-center justify-center">
          <svg class="w-64 h-64 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
          </svg>
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Core Service
          </div>
          <h2 class="text-3xl font-bold text-secondary-900 mb-4">Cloud Solutions</h2>
          <p class="text-lg text-secondary-600 mb-6">
            Leverage the power of cloud computing to increase flexibility, reduce costs, and improve collaboration. We help businesses migrate to and manage cloud environments with expertise in major platforms.
          </p>
          <ul class="space-y-3 text-secondary-600">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Cloud migration strategy and execution
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Hybrid cloud architecture
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Microsoft 365 and Azure solutions
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Cloud cost optimization
            </li>
          </ul>
        </div>
      </div>

      <!-- Security Systems -->
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Core Service
          </div>
          <h2 class="text-3xl font-bold text-secondary-900 mb-4">Security Systems</h2>
          <p class="text-lg text-secondary-600 mb-6">
            Protect your business from evolving cyber threats with comprehensive security solutions. We implement multi-layered defense strategies tailored to your risk profile and compliance requirements.
          </p>
          <ul class="space-y-3 text-secondary-600">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Network security assessment
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Firewall and intrusion prevention
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Endpoint protection solutions
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Security awareness training
            </li>
          </ul>
        </div>
        <div class="bg-secondary-100 rounded-2xl p-8 flex items-center justify-center">
          <svg class="w-64 h-64 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
      </div>

      <!-- IT Consulting -->
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">
        <div class="order-2 lg:order-1 bg-secondary-100 rounded-2xl p-8 flex items-center justify-center">
          <svg class="w-64 h-64 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Advisory
          </div>
          <h2 class="text-3xl font-bold text-secondary-900 mb-4">IT Consulting</h2>
          <p class="text-lg text-secondary-600 mb-6">
            Make informed technology decisions with expert guidance. Our consulting services help you develop IT strategies that align with your business goals and maximize your technology investments.
          </p>
          <ul class="space-y-3 text-secondary-600">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Technology roadmap development
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              IT budget planning
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Vendor selection and management
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Digital transformation guidance
            </li>
          </ul>
        </div>
      </div>

      <!-- Data Management -->
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Core Service
          </div>
          <h2 class="text-3xl font-bold text-secondary-900 mb-4">Data Management</h2>
          <p class="text-lg text-secondary-600 mb-6">
            Ensure your critical business data is secure, accessible, and recoverable. We implement comprehensive data management solutions that protect against data loss and support business continuity.
          </p>
          <ul class="space-y-3 text-secondary-600">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Backup and disaster recovery
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Data storage solutions
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Business continuity planning
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Data archiving and compliance
            </li>
          </ul>
        </div>
        <div class="bg-secondary-100 rounded-2xl p-8 flex items-center justify-center">
          <svg class="w-64 h-64 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
          </svg>
        </div>
      </div>

      <!-- Technical Support -->
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1 bg-secondary-100 rounded-2xl p-8 flex items-center justify-center">
          <svg class="w-64 h-64 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-700 rounded-full text-sm font-semibold mb-4">
            Ongoing Support
          </div>
          <h2 class="text-3xl font-bold text-secondary-900 mb-4">Technical Support</h2>
          <p class="text-lg text-secondary-600 mb-6">
            Keep your systems running smoothly with responsive technical support. From routine maintenance to emergency troubleshooting, we're here to ensure your technology works when you need it.
          </p>
          <ul class="space-y-3 text-secondary-600">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Remote and on-site support
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Proactive system monitoring
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Help desk services
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-primary-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Managed IT services
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-primary-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Ready to Transform Your IT Infrastructure?</h2>
      <p class="text-xl text-primary-100 max-w-3xl mx-auto mb-8">
        Let's discuss how Framework Systems can help your business achieve its technology goals.
      </p>
      <a href="/contact" class="inline-flex items-center bg-white text-primary-600 hover:bg-primary-50 px-8 py-3 rounded-lg font-semibold transition-colors">
        Schedule a Free Consultation
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
