---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Framework Systems - AI-powered business automations for local businesses in Tuscumbia, Alabama. Missed call text-back, review automation, AI receptionists. Built in minutes, runs 24/7." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Framework Systems</title>
  </head>
  <body class="min-h-screen bg-white text-secondary-900">
    <header class="bg-secondary-900 text-white sticky top-0 z-50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="/" class="flex items-center space-x-2">
            <svg class="w-8 h-8 text-primary-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span class="text-xl font-bold">Framework Systems</span>
          </a>

          <div class="hidden md:flex items-center space-x-8">
            <a href="/" class="hover:text-primary-400 transition-colors">Home</a>
            <a href="/services" class="hover:text-primary-400 transition-colors">Automations</a>
            <a href="/locations" class="hover:text-primary-400 transition-colors">Locations</a>
            <a href="/about" class="hover:text-primary-400 transition-colors">About</a>
            <a href="/contact" class="bg-primary-600 hover:bg-primary-700 px-4 py-2 rounded-lg transition-colors">Get Demo</a>
          </div>

          <button id="mobile-menu-btn" class="md:hidden p-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden pb-4">
          <div class="flex flex-col space-y-2">
            <a href="/" class="py-2 hover:text-primary-400 transition-colors">Home</a>
            <a href="/services" class="py-2 hover:text-primary-400 transition-colors">Automations</a>
            <a href="/locations" class="py-2 hover:text-primary-400 transition-colors">Locations</a>
            <a href="/about" class="py-2 hover:text-primary-400 transition-colors">About</a>
            <a href="/contact" class="py-2 text-primary-400 font-semibold">Get Demo</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-secondary-900 text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <h3 class="text-lg font-bold mb-4">Framework Systems</h3>
            <p class="text-secondary-400">AI-powered automations for local businesses. Built in minutes. Runs 24/7.</p>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Quick Links</h4>
            <ul class="space-y-2 text-secondary-400">
              <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
              <li><a href="/services" class="hover:text-white transition-colors">Automations</a></li>
              <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
              <li><a href="/contact" class="hover:text-white transition-colors">Get Demo</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Automations</h4>
            <ul class="space-y-2 text-secondary-400">
              <li>Missed Call Text-Back</li>
              <li>Review Automation</li>
              <li>AI Receptionist</li>
              <li>No-Show Recovery</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Service Area</h4>
            <ul class="space-y-2 text-secondary-400">
              <li>Tuscumbia, AL (HQ)</li>
              <li>Florence, AL</li>
              <li>Muscle Shoals, AL</li>
              <li>Sheffield, AL</li>
            </ul>
          </div>
        </div>
        <div class="border-t border-secondary-700 mt-8 pt-8 text-center text-secondary-400">
          <p>&copy; {new Date().getFullYear()} Framework Systems. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
